// 1. Função de Login
async function fazerLogin(email, password) {
  const errorEl = document.getElementById('loginErrorMsg');
  try {
    const client = window.supabaseClient || supabaseClient;
    if (!client) {
      throw new Error("Conexão com o Supabase não encontrada.");
    }

    const { data, error } = await client.auth.signInWithPassword({
      email: email,
      password: password
    });

    if (error) {
      if (errorEl) {
        errorEl.innerText = "Erro ao entrar: " + error.message;
        errorEl.style.display = 'block';
      } else {
        alert("Erro ao entrar: " + error.message);
      }
      return false;
    }
    
    return true;
  } catch (err) {
    if (errorEl) {
      errorEl.innerText = "Erro de execução: " + err.message;
      errorEl.style.display = 'block';
    } else {
      alert("Erro de execução: " + err.message);
    }
    return false;
  }
}

// 2. Função de Cadastro
async function criarConta(email, password) {
  const errorEl = document.getElementById('loginErrorMsg');
  try {
    const client = window.supabaseClient || supabaseClient;
    if (!client) {
      throw new Error("Conexão com o Supabase não encontrada.");
    }

    const { data, error } = await client.auth.signUp({
      email: email,
      password: password
    });

    if (error) {
      if (errorEl) {
        errorEl.innerText = "Erro ao cadastrar: " + error.message;
        errorEl.style.display = 'block';
      } else {
        alert("Erro ao cadastrar: " + error.message);
      }
      return false;
    }

    alert("Conta criada com sucesso!");
    return true;
  } catch (err) {
    if (errorEl) {
      errorEl.innerText = "Erro de execução: " + err.message;
      errorEl.style.display = 'block';
    } else {
      alert("Erro de execução: " + err.message);
    }
    return false;
  }
}

// 3. Função de Logout
async function fazerLogout() {
  try {
    const client = window.supabaseClient || supabaseClient;
    if (client) {
      await client.auth.signOut();
    }
  } catch (e) {
    console.error(e);
  }
  window.location.reload();
}
