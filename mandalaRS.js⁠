    { name: "Capricórnio", ruler: "Saturno" }, { name: "Aquário", ruler: "Saturno" }, { name: "Peixes", ruler: "Júpiter" }
  ];

  const SIGN_ELEMENTS = ["fire", "earth", "air", "water", "fire", "earth", "air", "water", "fire", "earth", "air", "water"];
  const ELEMENT_SIGN_COLORS = { fire: "#e84118", earth: "#8b4513", air: "#0ea5e9", water: "#1d4ed8" };

  const PLANETS_DEF = [
    { id: "Sun", name: "Sol", symbol: "☉", key: "Sol" },
    { id: "Moon", name: "Lua", symbol: "☽", key: "Lua" },
    { id: "Mercury", name: "Mercúrio", symbol: "☿", key: "Mercúrio" },
    { id: "Venus", name: "Vênus", symbol: "♀", key: "Vênus" },
    { id: "Mars", name: "Marte", symbol: "♂", key: "Marte" },
    { id: "Jupiter", name: "Júpiter", symbol: "♃", key: "Júpiter" },
    { id: "Saturn", name: "Saturno", symbol: "♄", key: "Saturno" }
  ];

  function formatDegMin(absDeg) {
    const degInSign = absDeg % 30;
    const degrees = Math.floor(degInSign);
    const minutes = Math.round((degInSign - degrees) * 60);
    return `${degrees}°${minutes < 10 ? '0' + minutes : minutes}′`;
  }

  function eclToScreenAngle(eclDeg, refAbs) {
    return (180 - (eclDeg - refAbs) + 36000) % 360;
  }

  function polarToCart(cx, cy, r, angleDeg) {
    const rad = angleDeg * Math.PI / 180.0;
    return { x: cx + (r * Math.cos(rad)), y: cy + (r * Math.sin(rad)) };
  }

  function gerarSvgMandala(mapData, titulo) {
    const ascAbs = mapData.Ascendente.grau_absoluto;
    const width = 960, height = 1100, cx = 480, cy = 600;
    const goldColor = "#c59b27";

    let svg = `<svg viewBox="0 0 ${width} ${height}" xmlns="http://www.w3.org/2000/svg" style="width:100%; height:auto;">
      <rect width="${width}" height="${height}" fill="#ffffff"/>
      <text x="480" y="60" font-family="'Cinzel', serif" font-size="28" font-weight="800" fill="#103b70" text-anchor="middle">${titulo}</text>
      <circle cx="${cx}" cy="${cy}" r="215" fill="none" stroke="${goldColor}" stroke-width="2"/>
    </svg>`;
    return svg;
  }

  window.renderizarMandalasDuplasRS = function(containerId, dadosNatal, dadosSolar) {
    const container = document.getElementById(containerId);
    if (!container) return;

    if (!dadosNatal || !dadosSolar) {
      container.innerHTML = `<p style="color: #64748b; text-align: center; padding: 20px;">Aguardando dados dos mapas...</p>`;
      return;
    }

    const svgSolar = gerarSvgMandala(dadosSolar, "Revolução Solar");
    const svgNatal = gerarSvgMandala(dadosNatal, "Mapa Natal (Radix)");

    container.innerHTML = `
      <div style="display: flex; flex-wrap: wrap; gap: 20px; justify-content: center; align-items: flex-start; width: 100%; max-width: 1200px; margin: 20px auto;">
        <div style="flex: 1; min-width: 320px; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px; padding: 10px; box-sizing: border-box;">
          ${svgSolar}
        </div>
        <div style="flex: 1; min-width: 320px; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px; padding: 10px; box-sizing: border-box;">
          ${svgNatal}
        </div>
      </div>
    `;
  };

  async function buscarDadosAPI(dataStr, horaStr, fusoVal, latVal, lonVal) {
    const urlApi = `https://motor-astrologia.vercel.app/api/index?data=${dataStr}&hora=${horaStr}&fuso=${fusoVal}&lat=${latVal}&lon=${lonVal}`;
    const res = await fetch(urlApi);
    if (!res.ok) throw new Error("Erro na API ao buscar dados");
    return await res.json();
  }

  window.executarCalculoRS = async function(dadosPerfil, anoRevolucao) {
    const container = document.getElementById('mandala-container');
    if (container) {
      container.innerHTML = `<p style="color: #64748b; text-align: center; padding: 20px;">Calculando Revolução Solar...</p>`;
    }
  };

})();
